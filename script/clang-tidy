def gcc_multilib_directory(idedata: dict[str, Any]) -> str | None:
    """The toolchain's active multilib subdirectory (e.g. "thumb"), if any.

    PlatformIO's idedata lists the generic toolchain include directories; GCC
    resolves the active multilib subdirectory internally while searching them.
    Toolchains without a default multilib (pico-quick-toolchain 5.0.0+) ship
    the libstdc++ target config (bits/c++config.h) only inside the multilib
    subdirectories, so clang needs the resolved directory spelled out.
    """
    machine_flags = [f for f in idedata["cxx_flags"] if f.startswith("-m")]
    cmd = [idedata["cxx_path"], *machine_flags, "-print-multi-directory"]
    try:
        multilib = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError) as err:
        # Without the multilib dir, toolchains lacking a default multilib fail
        # later with "bits/c++config.h not found"; point at the probe instead.
        stderr = getattr(err, "stderr", "") or ""
        print(
            f"WARNING: multilib probe failed ({shlex.join(cmd)}): {err} {stderr}".strip(),
            file=sys.stderr,
        )
        return None
    return None if multilib in ("", ".") else multilib


def clang_options(idedata, environment):
    cmd = []

    # extract target architecture from triplet in g++ filename
    triplet = Path(idedata["cxx_path"]).name[:-4]
    if triplet.startswith("xtensa-"):
        # clang has an Xtensa frontend, but only a generic core -- the esp32 IDF
        # toolchain headers (xtruntime, xtensa/config) need the GCC core config
        # (XCHAL_*) it doesn't ship, so we still compile in 32-bit x86 mode and
        # just pretend to be Xtensa. Undefine the host x86 arch macros -m32 sets,
        # so libraries with x86 SIMD paths (FastLED's fl/math/simd, simd_x86.hpp)
        # fall back to their scalar implementation instead of an incomplete
        # host-x86 one, and define the xtensa endianness macro newlib's
        # machine/ieeefp.h then needs in their place.
        cmd.append("-m32")
        cmd.append("-U__i386__")
        cmd.append("-U__x86_64__")
        cmd.append("-D__XTENSA__")
        cmd.append("-D__XTENSA_EL__")
        cmd.append("-D_LIBC")
    else:
        # RISC-V (and other non-Xtensa targets) have a real clang backend, so
        # compile for the actual triplet. Espressif's RISC-V GCC -march adds
        # vendor extensions (xesploop, xespv) upstream clang doesn't know; those
        # are stripped from the copied cxx_flags below.
        cmd.append(f"--target={triplet}")
        # The GCC build passes flags (e.g. -fno-plt) that clang accepts for some
        # targets but not others; don't error on the ones unused for this target.
        cmd.append("-Qunused-arguments")

    omit_flags = (
        "-free",
        "-fipa-pta",
        "-fstrict-volatile-bitfields",
        "-mlongcalls",
        "-mtext-section-literals",
        "-mdisable-hardware-atomics",
        "-mfix-esp32-psram-cache-issue",
        "-mfix-esp32-psram-cache-strategy=memw",
        "-fno-tree-switch-conversion",
        # GCC-only flags emitted by the native ESP-IDF toolchain build
        "-freorder-blocks",
        "-fno-jump-tables",
        "-fno-shrink-wrap",
        "-mno-target-align",
        # GCC-only flag emitted by the LibreTiny build
        "-mthumb-interwork",
    )

    # set flags
    cmd.extend(
        [
            # disable built-in include directories from the host
            "-nostdinc++",
            "-nostdinc",
            # allow to condition code on the presence of clang-tidy
            "-DCLANG_TIDY",
            # (esp-idf) Fix __once_callable in some libstdc++ headers
            "-D_GLIBCXX_HAVE_TLS",
            # suppress warning about attribute cannot be applied to type
            # https://github.com/esp8266/Arduino/pull/8258
            # also keeps deprecation diagnostics consistent across environments
            "-Ddeprecated(x)=",
        ]
    )

    if environment.startswith("rp2"):
        # clang's ARM backend doesn't know GCC's long_call attribute (IRAM_ATTR)
        cmd.append("-Wno-unknown-attributes")
    elif environment.startswith(("bk72xx", "ln882h", "rtl87xx")):
        cmd.extend(
            [
                # GCC on arm-none-eabi types (u)int32_t as (unsigned) long; clang
                # types it as (unsigned) int, clashing with LibreTiny's lwip
                # port typedefs. Match the GCC type model.
                "-U__UINT32_TYPE__",
                "-D__UINT32_TYPE__=long unsigned int",
                "-U__INT32_TYPE__",
                "-D__INT32_TYPE__=long int",
                # newlib's machine/endian.h macroizes __bswap16 into
                # __builtin_bswap16; the beken BDK then defines __bswap16 as a
                # function, which GCC tolerates as a builtin redeclaration but
                # clang rejects
                "-D__MACHINE_ENDIAN_H__",
            ]
        )
    else:
        # replace pgmspace.h, as it uses GNU extensions clang doesn't support
        # https://github.com/earlephilhower/newlib-xtensa/pull/18
        # arduino-pico ships clang-parseable pgmspace inline functions, so the
        # replacements are skipped there (they clash with those definitions).
        cmd.extend(
            [
                "-D_PGMSPACE_H_",
                "-Dpgm_read_byte(s)=(*(const uint8_t *)(s))",
                "-Dpgm_read_byte_near(s)=(*(const uint8_t *)(s))",
                "-Dpgm_read_word(s)=(*(const uint16_t *)(s))",
                "-Dpgm_read_dword(s)=(*(const uint32_t *)(s))",
                "-Dpgm_read_ptr(s)=(*(const void *const *)(s))",
                "-DPROGMEM=",
                "-DPGM_P=const char *",
                "-DPSTR(s)=(s)",
                # this next one is also needed with upstream pgmspace.h
                # suppress warning about identifier naming in expansion of this macro
                "-DPSTRN(s, n)=(s)",
            ]
        )

    # Copy compiler flags, dropping: ones clang doesn't understand; -Werror*
    # (clang-tidy enforces .clang-tidy's WarningsAsErrors, and a build -Werror
    # would bypass the -clang-diagnostic-* suppressions); and -std= (the native
    # ESP-IDF build defaults to gnu++2b, but ESPHome compiles with gnu++20 per
    # platformio.ini -- analyzing as C++23 flags code that doesn't build under
    # gnu++20). Force gnu++20 to match the real build.
    # Strip Espressif's non-standard RISC-V -march extensions (e.g. xesploop,
    # xespv); clang rejects the whole arch string otherwise.
    def strip_esp_march(flag):
        if flag.startswith("-march=") and triplet.startswith("riscv"):
            return re.sub(r"_xesp\w+", "", flag)
        return flag

    cmd.extend(
        strip_esp_march(flag)
        for flag in idedata["cxx_flags"]
        if flag not in omit_flags
        and not flag.startswith("-Werror")
        and not flag.startswith("-std=")
        and not flag.startswith("-mtune=esp")
    )
    cmd.append("-std=gnu++20")

    if environment.startswith(("bk72xx", "ln882h", "rtl87xx")):
        # LibreTiny leaves function-like macro values unparenthesized
        # (bugprone-macro-parentheses); its SDK-internal FAL_PART_TABLE macro trips the same
        # check. Assumes define values are always expressions (never type- or char-literal),
        # which holds for the current LibreTiny idedata.
        def sanitize_define(define):
            name, sep, value = define.partition("=")
            if (
                sep
                and value
                and not value.startswith(("(", '"'))
                and ("(" in name or not re.fullmatch(r"[\w.]+", value))
            ):
                value = f"({value})"
            return f"-D{name}{sep}{value}"

        # FAL_PART_TABLE and the delay() remap are library-scope LibreTiny flags that the real
        # build never applies to esphome sources. Strip LibreTiny's shell quoting from define
        # names first so the skip list matches regardless of which names it happens to quote.
        for define in idedata["defines"]:
            define = define.replace("'", "")
            if define.startswith(("FAL_PART_TABLE", "delay(")):
                continue
            cmd.append(sanitize_define(define))
    else:
        cmd.extend(f"-D{define}" for define in idedata["defines"])

    # toolchain include directories, using -isystem to suppress their errors
    # idedata contains include directories for all toolchains of this platform, only use those from the one in use
    toolchain_dir = os.path.normpath(f"{idedata['cxx_path']}/../../")
    multilib = gcc_multilib_directory(idedata)
    toolchain_includes = []
    for directory in idedata["includes"]["toolchain"]:
        if directory.startswith(toolchain_dir) and "picolibc" not in directory:
            if multilib and (multilib_dir := Path(directory) / multilib).is_dir():
                toolchain_includes.extend(["-isystem", str(multilib_dir)])
            toolchain_includes.extend(["-isystem", directory])

    # library include directories, using -isystem to suppress their errors
    build_includes = []
    for directory in list(idedata["includes"]["build"]):
        # skip our own directories, we add those later
        if (
            not directory.startswith(f"{root_path}")
            or directory.startswith(
                (
                    f"{root_path}/.platformio",
                    f"{root_path}/.temp",
                    f"{root_path}/managed_components",
                )
            )
            or (directory.startswith(f"{root_path}") and "/.pio/" in directory)
        ):
            build_includes.extend(["-isystem", directory])

    cmd.extend(toolchain_includes + build_includes)

    # add the esphome include directory using -I
    cmd.extend(["-I", root_path])

    return cmd


pids = set()

# Checks disabled for "rp2", "bk72xx", "ln882h", "rtl87xx"
TIDY_DISABLED_CHECKS = [
    # MMIO peripheral access on these bare-metal platforms is all
    # fixed-address.
    # bugprone-pointer-arithmetic-on-polymorphic-object (and its
    # cert-ctr56-cpp alias) crashes clang-tidy 22 with infinite matcher
    # recursion on lvgl_esphome.h under the RP2 defines.
    "clang-analyzer-core.FixedAddressDereference",
    "bugprone-pointer-arithmetic-on-polymorphic-object",
    "cert-ctr56-cpp",
]

# Checks disabled for zephyr -- see run_codechecker_zephyr() below.
CODECHECKER_DISABLED_CHECKS = [
    # Zephyr's generated autoconf.h and ZBOSS's own headers define
    # unparenthesized macro values (e.g. `-1`); not source we control.
    "bugprone-macro-parentheses",
    # MMIO peripheral access on this platform is all fixed-address
    "clang-analyzer-core.FixedAddressDereference",
    # Circular includes inside Zephyr/ZBOSS's own SDK headers -- not ours to
    # restructure.
    "misc-header-include-cycle",
]


def run_tidy(executable, args, options, tmpdir, path_queue, lock, failed_files):
    while True:
        path = path_queue.get()
        invocation = [executable]

        if tmpdir is not None:
            invocation.append("--export-fixes")
            # Get a temporary file. We immediately close the handle so clang-tidy can
            # overwrite it.
            (handle, name) = tempfile.mkstemp(suffix=".yaml", dir=tmpdir)
            os.close(handle)
            invocation.append(name)

        if args.quiet:
            invocation.append("--quiet")

        if sys.stdout.isatty():
            invocation.append("--use-color")

        if (
            args.environment.startswith(("rp2", "bk72xx", "ln882h", "rtl87xx"))
            and TIDY_DISABLED_CHECKS
        ):
            invocation.append(
                "--checks=" + ",".join(f"-{c}" for c in TIDY_DISABLED_CHECKS)
            )
        invocation.append(f"--header-filter={Path(basepath).resolve()}/.*")
        invocation.append(str(Path(path).resolve()))
        invocation.append("--")
        invocation.extend(options)

        proc = subprocess.run(
            invocation,
            capture_output=True,
            encoding="utf-8",
            check=False,
            close_fds=False,
        )
        if proc.returncode != 0:
            with lock:
                print_error_for_file(path, proc.stdout)
                failed_files.append(path)
        path_queue.task_done()


def progress_bar_show(value):
    if value is None:
        return ""
    return None


def _read_pinned_version(requirements_path: Path, package: str) -> tuple[int, int]:
    """Read the major.minor version pinned for ``package`` in a requirements file."""
    match = re.search(
        rf"^{re.escape(package)}==(\d+)\.(\d+)",
        requirements_path.read_text(encoding="utf-8"),
        re.MULTILINE,
    )
    if match is None:
        raise RuntimeError(
            f"Could not find a '{package}==<version>' pin in {requirements_path}"
        )
    return int(match.group(1)), int(match.group(2))


def _codechecker_pinned_version() -> tuple[int, int]:
    return _read_pinned_version(
        Path(root_path) / "requirements_codechecker.txt", "codechecker"
    )


def _clang_tidy_pinned_major() -> int:
    return _read_pinned_version(Path(root_path) / "requirements_dev.txt", "clang-tidy")[
        0
    ]


def _format_version(version: tuple[int, int] | int | None) -> str:
    """Format a parsed version for an error message, or "unknown" if unparseable."""
    if version is None:
        return "unknown"
    if isinstance(version, tuple):
        return ".".join(str(part) for part in version)
    return str(version)


def _get_codechecker_binary(pinned_version: tuple[int, int]) -> str:
    """Verify the installed CodeChecker analyzer package version is pin-compatible.

    Hard-pins the major version, soft-pins the minor version (installed must be
    >= pinned), and does not pin the patch version at all. Raises
    FileNotFoundError if the binary itself is missing (propagated from
    subprocess.run), or RuntimeError if it ran but didn't report a
    pin-compatible analyzer version.
    """
    pinned_major, pinned_minor = pinned_version
    result = subprocess.run(
        ["CodeChecker", "version"], text=True, capture_output=True, check=False
    )
    section_match = re.search(
        r"CodeChecker analyzer version:(.*?)(?:CodeChecker web version:|\Z)",
        result.stdout,
        re.IGNORECASE | re.DOTALL,
    )
    found_version = None
    if section_match and (
        field_match := re.search(
            r"Base package version\s*\|\s*(\d+)\.(\d+)", section_match.group(1)
        )
    ):
        found_version = (int(field_match.group(1)), int(field_match.group(2)))
    if (
        result.returncode == 0
        and found_version is not None
        and found_version[0] == pinned_major
        and found_version[1] >= pinned_minor
    ):
        return "CodeChecker"

    stderr = result.stderr.strip()
    raise RuntimeError(
        f"CodeChecker analyzer version {_format_version(found_version)} found, expected "
        f"{pinned_major}.{pinned_minor} or later within major version {pinned_major} "
        f"(exit code {result.returncode})" + (f": {stderr}" if stderr else "")
    )


def _verify_codechecker_clang_tidy(pinned_major: int) -> None:
    """Verify the plain ``clang-tidy`` on PATH matches the pinned major version.

    CodeChecker always resolves its analyzer via env.get_binary_in_path(['clang-tidy'],
    ...) -- unlike get_binary(), it never tries a versioned ``clang-tidy-<N>`` name -- so
    this checks that exact unversioned binary rather than reusing get_binary(). Raises
    FileNotFoundError if clang-tidy itself is missing (propagated from subprocess.run).
    """
    result = subprocess.run(
        ["clang-tidy", "--version"], text=True, capture_output=True, check=False
    )
    found_major = (
        int(version_match.group(1))
        if (version_match := re.search(r"version (\d+)", result.stdout))
        else None
    )
    if result.returncode == 0 and found_major == pinned_major:
        return

    stderr = result.stderr.strip()
    raise RuntimeError(
        f"clang-tidy on PATH is version {_format_version(found_major)}, expected "
        f"major version {pinned_major} (CodeChecker resolves clang-tidy from PATH, not "
        f"a versioned binary name) (exit code {result.returncode})"
        + (f": {stderr}" if stderr else "")
    )


def run_codechecker_zephyr(files: list[str], args: argparse.Namespace) -> int:
    """Analyze ``files`` for a zephyr/nrf52 environment via CodeChecker.

    CodeChecker ingests the real, unmodified GCC compile commands from a west
    build and does its own GCC->Clang toolchain/flag translation -- reuse that
    instead of reimplementing it in clang_options() below.
    """
    from esphome.components.nrf52.clang_tidy import generate_compile_commands

    try:
        # clang-tidy is what CodeChecker invokes as its analyzer, so its pin
        # is read first.
        clang_tidy_pin = _clang_tidy_pinned_major()
        codechecker_pin = _codechecker_pinned_version()
    except (FileNotFoundError, RuntimeError) as err:
        # Read before the binary-presence checks below so a missing/renamed
        # requirements file isn't misattributed to a missing binary.
        print(f"Could not determine pinned tool versions: {err}", file=sys.stderr)
        return 1

    try:
        executable = _get_codechecker_binary(codechecker_pin)
    except FileNotFoundError:
        # CodeChecker is deliberately kept out of requirements_dev.txt (see
        # requirements_codechecker.txt), so script/setup won't install it.
        print(
            "CodeChecker is not installed in this venv. Activate the venv and install it with:\n"
            "  pip install -r requirements_codechecker.txt",
            file=sys.stderr,
        )
        return 1
    except RuntimeError as err:
        print(f"CodeChecker version check failed: {err}", file=sys.stderr)
        return 1

    try:
        _verify_codechecker_clang_tidy(clang_tidy_pin)
    except FileNotFoundError:
        print(
            "clang-tidy is not installed in this venv. Activate the venv and install it with:\n"
            "  pip install -r requirements_dev.txt",
            file=sys.stderr,
        )
        return 1
    except RuntimeError as err:
        print(f"clang-tidy version check failed: {err}", file=sys.stderr)
        return 1

    work_dir = Path(temp_folder) / f"zephyr-{args.environment}"
    platformio_ini = Path(root_path) / "platformio.ini"

    from clang_tidy_hash import cache_key, is_cached, update_cache

    requested_sources = {Path(f).resolve() for f in files}

    cache_key_path = None
    key = None
    regenerated = False
    if explicit := os.environ.get("ESPHOME_ZEPHYR_COMPILE_COMMANDS"):
        compile_commands_path = Path(explicit)
    else:
        sorted_sources = sorted(str(p) for p in requested_sources)
        extra = "\n".join(sorted_sources)
        compile_commands_path = work_dir / "build" / "compile_commands.json"
        cache_key_path = work_dir / ".compile_commands.hash"
        # Snapshotted now, before the west configure/CodeChecker analyze
        # below -- see cache_key()'s docstring for why.
        key = cache_key(extra)
        # Skip the west/CMake reconfigure if nothing that affects the
        # generated compile commands has changed since the last run.
        if not compile_commands_path.is_file() or not is_cached(cache_key_path, key):
            compile_commands_path = generate_compile_commands(
                work_dir, platformio_ini, sorted_sources
            )
            regenerated = True
    if not compile_commands_path.is_file():
        print(
            f"compile_commands.json not found: {compile_commands_path}",
            file=sys.stderr,
        )
        return 1

    output_dir = Path(temp_folder) / f"codechecker-{args.environment}"
    if output_dir.is_dir():
        shutil.rmtree(output_dir)
    output_dir.mkdir(parents=True)

    # Scope findings to our own sources; take-config-from-directory makes
    # CodeChecker honor .clang-tidy instead of its own default check profile.
    tidy_args = [
        f"--header-filter={basepath}/.*",
        # Cancels .clang-tidy's WarningsAsErrors (appends, doesn't override) so a
        # finding books the file successful, not failed; parse's exit code still fails CI.
        "--warnings-as-errors=-*",
    ]
    if CODECHECKER_DISABLED_CHECKS:
        tidy_args.append(
            "--checks=" + ",".join(f"-{c}" for c in CODECHECKER_DISABLED_CHECKS)
        )
    # Written into output_dir (recreated above) so it doesn't leak into the
    # system temp directory across runs.
    tidy_args_path = output_dir / "tidy_args.txt"
    tidy_args_path.write_text("\n".join(tidy_args) + "\n", encoding="utf-8")

    file_patterns = [f"*{os.path.relpath(f, root_path)}" for f in files]

    result = subprocess.run(
        [
            executable,
            "analyze",
            str(compile_commands_path),
            "--analyzers",
            "clang-tidy",
            "--analyzer-config",
            "clang-tidy:take-config-from-directory=true",
            f"clang-tidy:cc-verbatim-args-file={tidy_args_path}",
            "-j",
            str(args.jobs),
            "-o",
            str(output_dir),
            "--file",
            *file_patterns,
        ],
        check=False,
    )

    # Report findings regardless of coverage below -- files that did analyze
    # successfully still have real findings worth surfacing even if others
    # crashed.
    parse_result = subprocess.run([executable, "parse", str(output_dir)], check=False)
    if parse_result.returncode not in (0, 2):
        # 0 = no reports, 2 = reports found -- anything else is parse/rendering
        # itself failing, which means findings went unreported, not that there
        # were none.
        print(
            f"CodeChecker parse failed (exit {parse_result.returncode})",
            file=sys.stderr,
        )

    def invalidate_stale_cache() -> None:
        """Drop a reused cache entry on failure; a regenerated database failing is not a cache problem."""
        if cache_key_path is not None and not regenerated:
            cache_key_path.unlink(missing_ok=True)

    try:
        metadata = json.loads((output_dir / "metadata.json").read_text())
    except (OSError, json.JSONDecodeError) as err:
        print(
            f"CodeChecker analyze failed (exit {result.returncode}): {err}",
            file=sys.stderr,
        )
        invalidate_stale_cache()
        return result.returncode or 1

    try:
        stats = metadata["tools"][0]["analyzers"]["clang-tidy"]["analyzer_statistics"]
        failed = stats["failed"]
        # successful_sources/failed_sources verified present (as absolute paths) against
        # the pinned CodeChecker 6.28.2; undocumented internal schema, not a stable API.
        failed_sources = {Path(p).resolve() for p in stats["failed_sources"]}
        analyzed_sources = failed_sources | {
            Path(p).resolve() for p in stats["successful_sources"]
        }
    except (KeyError, IndexError, TypeError) as err:
        # Distinct from the file-level failure above: metadata.json parsed fine,
        # but its internal shape (undocumented, tied to the pinned version) no
        # longer matches what this script expects -- most likely a CodeChecker
        # version bump renamed/restructured a key, not an analysis failure.
        print(
            f"metadata.json has an unexpected shape ({err!r}) -- "
            "CodeChecker's internal metadata format may have changed",
            file=sys.stderr,
        )
        invalidate_stale_cache()
        return 1

    # A count alone can't catch an over-match/under-match that cancels out.
    missing = requested_sources - analyzed_sources
    # file_patterns is an unanchored suffix glob (see its definition above), so
    # a short/non-distinctive relative path can match extra files elsewhere in
    # the compile database -- files these same patterns then let fixit --apply
    # mutate in place. requested subset of analyzed alone can't catch that.
    extra = analyzed_sources - requested_sources
    covered = not missing and not extra

    if failed:
        # Analyzer crashes/errors must not read as a clean run just because
        # they're counted alongside successes.
        print(
            f"ERROR: CodeChecker failed to analyze {failed} file(s):",
            file=sys.stderr,
        )
        for path in sorted(failed_sources):
            print(f"    {path}", file=sys.stderr)
        invalidate_stale_cache()
        return 1
    if not covered:
        # A --file/compile-database mismatch can analyze the wrong files and
        # exit 0 -- don't let that read as a clean run.
        if missing:
            print(
                "ERROR: CodeChecker never analyzed these requested files -- "
                "--file patterns may not match the compile database:",
                file=sys.stderr,
            )
            for path in sorted(missing):
                print(f"    {path}", file=sys.stderr)
        if extra:
            print(
                "ERROR: CodeChecker analyzed files that were never requested "
                "-- an over-matching --file pattern; fixit --apply would "
                "mutate these:",
                file=sys.stderr,
            )
            for path in sorted(extra):
                print(f"    {path}", file=sys.stderr)
        invalidate_stale_cache()
        return 1

    fixit_returncode = 0
    if args.fix:
        # Only reached once analyze is confirmed complete (failed == 0) and
        # covered above -- fixit --apply mutates source files in place, and
        # must never run against a partial/incomplete result set.
        # Apply serially (like run_tidy() below) instead of passing --fix to
        # CodeChecker's parallel workers, which would race on shared headers.
        # stdin=DEVNULL: fixit reads a `CodeChecker cmd diff` JSON from stdin
        # when present; we never want that here and don't want to inherit a
        # pipe that could block waiting for a writer that never closes.
        fixit_result = subprocess.run(
            [
                executable,
                "fixit",
                "--apply",
                str(output_dir),
                "--file",
                *file_patterns,
            ],
            stdin=subprocess.DEVNULL,
            check=False,
        )
        fixit_returncode = fixit_result.returncode
        if fixit_returncode != 0:
            print(
                f"CodeChecker fixit --apply failed (exit {fixit_returncode})",
                file=sys.stderr,
            )

    # Only recorded once analyze exited clean and coverage is confirmed --
    # otherwise a regenerated database that produced failures would be
    # cached as good.
    if regenerated and result.returncode == 0:
        update_cache(cache_key_path, key)

    # Does not return the number of failed files, just pass/fail
    return (
        1 if (fixit_returncode or result.returncode or parse_result.returncode) else 0
    )


def split_list(a, n):
    k, m = divmod(len(a), n)
    return [a[i * k + min(i, m) : (i + 1) * k + min(i + 1, m)] for i in range(n)]


def main():
    colorama.init()

    parser = argparse.ArgumentParser()
    parser.add_argument(
        "-j",
        "--jobs",
        type=int,
        default=get_usable_cpu_count(),
        help="number of tidy instances to be run in parallel.",
    )
    parser.add_argument(
        "-e",
        "--environment",
        default="esp32-arduino-tidy",
        help="the PlatformIO environment to use (as defined in platformio.ini)",
    )
    parser.add_argument(
        "files", nargs="*", default=[], help="files to be processed (regex on path)"
    )
    parser.add_argument("--fix", action="store_true", help="apply fix-its")
    parser.add_argument(
        "-q", "--quiet", action="store_false", help="run clang-tidy in quiet mode"
    )
    parser.add_argument(
        "-c", "--changed", action="store_true", help="only run on changed files"
    )
    parser.add_argument(
        "-g",
        "--grep",
        action="append",
        help="only run on files containing value",
    )
    parser.add_argument(
        "-x",
        "--exclude-grep",
        action="append",
        help="skip files containing value",
    )
    parser.add_argument(
        "--split-num", type=int, help="split the files into X jobs.", default=None
    )
    parser.add_argument(
        "--split-at", type=int, help="which split is this? starts at 1", default=None
    )
    parser.add_argument(
        "--all-headers",
        action="store_true",
        help="create a dummy file that checks all headers",
    )
    args = parser.parse_args()

    cwd = Path.cwd()
    files = [os.path.relpath(path, cwd) for path in git_ls_files(["*.cpp"])]
    # Exclude benchmark files — they require google benchmark headers not
    # available in the ESP32 toolchain and use different naming conventions.
    files = [f for f in files if not f.startswith("tests/benchmarks/")]

    # Print initial file count if it's large
    if len(files) > 50:
        print(f"Found {len(files)} total files to process")

    if args.files:
        # Match against files specified on command-line
        file_name_re = re.compile("|".join(args.files))
        files = [p for p in files if file_name_re.search(p)]

    if args.changed:
        files = filter_changed(files)

    if args.grep:
        files = filter_grep(files, args.grep)

    if args.exclude_grep:
        excluded = set(filter_grep(files, args.exclude_grep))
        files = [f for f in files if f not in excluded]

    files.sort()

    if args.split_num:
        files = split_list(files, args.split_num)[args.split_at - 1]
        print(f"Split {args.split_at}/{args.split_num}: checking {len(files)} files")

    # Print file count before adding header file
    print(f"\nTotal cpp files to check: {len(files)}")

    # Add header file for checking (before early exit check)
    if args.all_headers and args.split_at in (None, 1):
        # When --changed is used, only include changed headers instead of all headers
        if args.changed:
            all_headers = [
                os.path.relpath(p, cwd) for p in git_ls_files(["esphome/**/*.h"])
            ]
            changed_headers = filter_changed(all_headers)
            if changed_headers:
                build_all_include(changed_headers)
                files.insert(0, temp_header_file)
            else:
                print("No changed headers to check")
        else:
            build_all_include()
            files.insert(0, temp_header_file)
            print(f"Added all-include header file, new total: {len(files)}")

    # Early exit if no files to check
    if not files:
        print("No files to check - exiting early")
        return 0

    # Print final file list before loading idedata
    print_file_list(files, "Final files to process:")

    # Zephyr/nrf52 goes through CodeChecker instead of this script's manual
    # GCC->Clang flag translation -- see run_codechecker_zephyr().
    if "nrf" in args.environment:
        return run_codechecker_zephyr(files, args)

    # Load idedata and options only if we have files to check
    idedata = load_idedata(args.environment)
    options = clang_options(idedata, args.environment)

    tmpdir = None
    if args.fix:
        tmpdir = tempfile.mkdtemp()

    failed_files = []
    try:
        executable = get_binary("clang-tidy", 22)
        task_queue = queue.Queue(args.jobs)
        lock = threading.Lock()
        for _ in range(args.jobs):
            t = threading.Thread(
                target=run_tidy,
                args=(
                    executable,
                    args,
                    options,
                    tmpdir,
                    task_queue,
                    lock,
                    failed_files,
                ),
            )
            t.daemon = True
            t.start()

        # Fill the queue with files.
        with click.progressbar(
            files, width=30, file=sys.stderr, item_show_func=progress_bar_show
        ) as progress_bar:
            for name in progress_bar:
                task_queue.put(name)

        # Wait for all threads to be done.
        task_queue.join()

    except FileNotFoundError:
        return 1
    except KeyboardInterrupt:
        print()
        print("Ctrl-C detected, goodbye.")
        if tmpdir:
            shutil.rmtree(tmpdir)
        # Kill subprocesses (and ourselves!)
        # No simple, clean alternative appears to be available.
        os.kill(0, 9)
        return 2  # Will not execute.

    if args.fix and failed_files:
        print("Applying fixes ...")
        try:
            try:
                subprocess.call(
                    ["clang-apply-replacements-22", tmpdir], close_fds=False
                )
            except FileNotFoundError:
                subprocess.call(["clang-apply-replacements", tmpdir], close_fds=False)
        except FileNotFoundError:
            print(
                "Error please install clang-apply-replacements-22 or clang-apply-replacements.\n",
                file=sys.stderr,
            )
        except:
            print("Error applying fixes.\n", file=sys.stderr)
            raise

    # Cap at 255: shells truncate exit codes to one byte, so 256 failures
    # would otherwise report success
    return min(len(failed_files), 255)


if __name__ == "__main__":
    sys.exit(main())
