{
  "name": "esphome.io",
  "version": "2.0.0",
  "description": "ESPHome Documentation",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "serve": "astro build && astro preview --host",
    "lint": "node script/lint.mjs",
    "lint:js": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,astro,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,astro,css}\""
  },
  "dependencies": {
    "@astrojs/starlight": "^0.39.3",
    "astro": "^6.4.4",
    "katex": "^0.17.0",
    "micromark": "^4.0.2",
    "rehype-katex": "^7.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esphome/esphome.io.git"
  },
  "license": "CC-BY-4.0",
  "bugs": {
    "url": "https://github.com/esphome/esphome.io/issues"
  },
  "homepage": "https://esphome.io",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
