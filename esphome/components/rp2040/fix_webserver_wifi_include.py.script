# The Arduino Pico framework's WebServer library includes "WiFiServer.h"
# without declaring a dependency on WiFi. Add the include paths needed
# for WebServer to compile through the full transitive chain:
#   WebServer -> WiFi -> lwIP_CYW43 -> lwIP_Ethernet
import os

Import("env")
framework_dir = env.PioPlatform().get_package_dir("framework-arduinopico")
libs_dir = os.path.join(framework_dir, "libraries")
for lib in ("WiFi", "lwIP_CYW43", "lwIP_Ethernet"):
    src_dir = os.path.join(libs_dir, lib, "src")
    if os.path.isdir(src_dir):
        env.Prepend(CXXFLAGS=["-I" + src_dir])
