# The Arduino Pico framework's WebServer library includes "WiFiServer.h" but
# does not declare a dependency on the WiFi library. When compiled, the WiFi
# library's include paths are not automatically added to WebServer's build
# environment. Add WiFi's src/ directory to CXXFLAGS so WebServer compiles.
import os

Import("env")
framework_dir = env.PioPlatform().get_package_dir("framework-arduinopico")
wifi_src = os.path.join(framework_dir, "libraries", "WiFi", "src")
env.Prepend(CXXFLAGS=["-I" + wifi_src])
