import os

Import("env")  # noqa: F821

# Remove custom_sdkconfig from the board config as it causes
# pioarduino to enable some strange hybrid build mode that breaks IDF
board = env.BoardConfig()
if "espidf.custom_sdkconfig" in board:
    del board._manifest["espidf"]["custom_sdkconfig"]
    if not board._manifest["espidf"]:
        del board._manifest["espidf"]

# esphome/idf_component.yml gates arduino-only managed components (FastLED) on
# the ESPHOME_ARDUINO environment variable, and the IDF component manager
# fails hard when a referenced env var is unset. ESPHome's clang-tidy flow
# exports it, but a direct `pio run` from the repo's platformio.ini (IDE,
# devcontainer) does not -- default it from the environment's framework list.
# An explicit value in the caller's environment wins.
frameworks = env.get("PIOFRAMEWORK") or []
os.environ.setdefault("ESPHOME_ARDUINO", "1" if "arduino" in frameworks else "0")
