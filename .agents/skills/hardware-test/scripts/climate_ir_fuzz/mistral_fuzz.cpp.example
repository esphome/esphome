#include <gtest/gtest.h>
#include <memory>
#include "climate_fuzz.hpp"
#include "esphome/components/mistral_ir/mistral_ir.h"
namespace esphome::fuzz22773 {
TEST(Fuzz22773, MistralIR) {
  run("mistral", [] { return std::make_unique<mistral_ir::MistralIR>(); },
      [](std::mt19937 &rng, remote_base::RawTimings &raw) {
        size_t len = (rng() % 3 == 0) ? 2 + rng() % 34 : 12;
        aeha_random(rng, raw, len, mistral_ir::MISTRAL_ADDRESS, [](uint8_t *d) {
          d[0] = 0x56;
          d[2] = 0x08;
        });
      });
}
}  // namespace esphome::fuzz22773
