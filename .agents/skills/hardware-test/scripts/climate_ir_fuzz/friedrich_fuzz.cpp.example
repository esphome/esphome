#include <gtest/gtest.h>
#include <memory>
#include "climate_fuzz.hpp"
#include "esphome/components/friedrich/friedrich.h"
#include "esphome/components/remote_base/aeha_protocol.h"
namespace esphome::fuzz22773 {
TEST(Fuzz22773, Friedrich) {
  run("friedrich", [] { return std::make_unique<friedrich::FriedrichClimate>(); },
      [](std::mt19937 &rng, remote_base::RawTimings &raw) {
        uint8_t d[35];
        size_t len = (rng() % 3 == 0) ? 2 + rng() % 34 : ((rng() & 1) ? 14 : 5);
        for (auto &b : d) b = rng();
        if (rng() % 2) { d[0] = 0x00; d[1] = 0x08; d[2] = 0x08; }
        remote_base::RemoteTransmitData tx;
        remote_base::AEHAProtocol().encode(&tx, (rng() % 4) ? 0x28C6 : uint16_t(rng()), d, len);
        raw = tx.get_data();
      });
}
}  // namespace esphome::fuzz22773
