#include <gtest/gtest.h>
#include <memory>
#include "climate_fuzz.hpp"
#include "esphome/components/haier_tundra/haier_tundra.h"
#include "esphome/components/remote_base/haier_protocol.h"
namespace esphome::fuzz22773 {
TEST(Fuzz22773, HaierTundra) {
  run("haier_tundra", [] { return std::make_unique<haier_tundra::HaierTundra>(haier_tundra::HAIER_HEADER_UNIT_A); },
      [](std::mt19937 &rng, remote_base::RawTimings &raw) {
        uint8_t d[16];
        size_t len = (rng() % 3 == 0) ? 1 + rng() % 16 : 13;
        for (auto &b : d) b = rng();
        if (rng() % 2) d[0] = haier_tundra::HAIER_HEADER_UNIT_A;
        remote_base::RemoteTransmitData tx;
        remote_base::HaierProtocol().encode(&tx, d, len);
        raw = tx.get_data();
      });
}
}  // namespace esphome::fuzz22773
