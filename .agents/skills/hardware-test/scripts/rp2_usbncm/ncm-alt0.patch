-#include "../../../pico-sdk/lib/tinyusb/src/class/net/ncm_device.c"
+// Wrap the SDK driver's control request handler so the glue logic can follow the data interface state
+#define netd_control_xfer_cb __sdk_netd_control_xfer_cb
+#include <class/net/ncm_device.c>
+#undef netd_control_xfer_cb
+
+#if CFG_TUD_ENABLED && CFG_TUD_NCM
+#include "tusb-ncm.h"
+
+TU_ATTR_WEAK void tud_network_ncm_data_alt_cb(uint8_t alt) {
+    (void) alt;
+}
+
+uint8_t tud_network_ncm_data_alt(void) {
+    return ncm_interface.itf_data_alt;
+}
+
+bool netd_control_xfer_cb(uint8_t rhport, uint8_t stage, tusb_control_request_t const *request) {
+    bool ret = __sdk_netd_control_xfer_cb(rhport, stage, request);
+    if (ret && stage == CONTROL_STAGE_SETUP && request->bmRequestType_bit.type == TUSB_REQ_TYPE_STANDARD &&
+            request->bRequest == TUSB_REQ_SET_INTERFACE) {
+        tud_network_ncm_data_alt_cb(ncm_interface.itf_data_alt);
+    }
+    return ret;
+}
+#endif
