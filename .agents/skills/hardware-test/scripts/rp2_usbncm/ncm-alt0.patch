+#ifndef __FREERTOS
+// Some hosts select alternate setting 0 on the data interface right after 1 and never come back.
+// Detach and attach again so the host enumerates the device from scratch.
+static alarm_id_t _reenumerate_alarm = 0;
+static bool _reenumerate_detached = false;
+static uint32_t _reenumerate_wait_ms = NCMETHERNET_REENUMERATE_MS;
+
+static int64_t _reenumerate_cb(alarm_id_t id, void *user_data) {
+    (void) id;
+    (void) user_data;
+    if (!mutex_try_enter(&USB.mutex, nullptr)) {
+        return 10000; // USB busy, try again in 10ms
+    }
+    if (!_reenumerate_detached) {
+        tud_disconnect();
+        _reenumerate_detached = true;
+        mutex_exit(&USB.mutex);
+        return 500000; // stay detached long enough for the host to notice
+    }
+    tud_connect();
+    _reenumerate_detached = false;
+    _reenumerate_alarm = 0;
+    mutex_exit(&USB.mutex);
+    return 0;
+}
+#endif
+
 extern "C" {
     // data transfer between tinyUSB callbacks and NCMEthernet class
     NCMEthernet *_ncm_ethernet_instance = nullptr;

+#ifndef __FREERTOS
+    void tud_network_ncm_data_alt_cb(uint8_t alt) {
+        // called from tud_task() with the USB mutex held
+        if (alt == 1) {
+            if (_reenumerate_alarm > 0 && !_reenumerate_detached) {
+                cancel_alarm(_reenumerate_alarm);
+                _reenumerate_alarm = 0;
+            }
+        } else if (_reenumerate_alarm <= 0) {
+            _reenumerate_alarm = add_alarm_in_ms(_reenumerate_wait_ms, _reenumerate_cb, nullptr, true);
+            _reenumerate_wait_ms = min(_reenumerate_wait_ms * 2, (uint32_t) NCMETHERNET_REENUMERATE_MAX_MS);
+        }
+    }
+#endif
+
     /*
         Interface to tinyUSB.
     */
