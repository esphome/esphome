#pragma once
// Types of ESP-IDF 5.5.5 esp_driver_i2c used by i2c_bus_esp_idf, with an execute model that puts the jobs on the
// wab wire and applies the driver's own argument checks (command count, NACK before STOP).
#include <cstddef>
#include <cstdint>
typedef int esp_err_t;
#define ESP_OK 0
#define ESP_FAIL -1
#define ESP_ERR_INVALID_ARG 0x102
#define ESP_ERR_INVALID_STATE 0x103
#define ESP_ERR_INVALID_RESPONSE 0x108
#define ESP_ERR_TIMEOUT 0x107
inline const char *esp_err_to_name(esp_err_t) { return "err"; }
typedef int i2c_port_t;
typedef enum { I2C_MASTER_WRITE = 0, I2C_MASTER_READ } i2c_rw_t;
typedef enum { I2C_ACK_VAL = 0, I2C_NACK_VAL = 1 } i2c_ack_value_t;
typedef enum { I2C_MASTER_CMD_START, I2C_MASTER_CMD_WRITE, I2C_MASTER_CMD_READ, I2C_MASTER_CMD_STOP } i2c_master_command_t;
typedef struct i2c_master_bus_t *i2c_master_bus_handle_t;
typedef struct i2c_master_dev_t *i2c_master_dev_handle_t;
typedef struct {
  i2c_master_command_t command;
  union {
    struct {
      bool ack_check;
      uint8_t *data;
      size_t total_bytes;
    } write;
    struct {
      i2c_ack_value_t ack_value;
      uint8_t *data;
      size_t total_bytes;
    } read;
  };
} i2c_operation_job_t;
#ifndef SOC_I2C_CMD_REG_NUM
#define SOC_I2C_CMD_REG_NUM 8  // C2, C3, C6, S3, P4; 16 on ESP32 and S2
#endif
esp_err_t i2c_master_execute_defined_operations(i2c_master_dev_handle_t dev, i2c_operation_job_t *ops, size_t n,
                                                int timeout_ms);
