// ESP-IDF bus body of the tree under test on the IDF 5.5.5 job model
#include <string>
#include "esphome/core/application.h"
#include "esphome/core/component.h"
#include "esphome/core/hal.h"
#include "esphome/core/helpers.h"
#include "esphome/core/log.h"
#include "esphome/components/i2c/i2c_bus.h"
#include "wab_common.h"
#define USE_ESP32
#include "esphome/components/i2c/i2c_bus_esp_idf.h"
namespace esphome::i2c {
ESPHOME_LOG_TAG(TAG, "i2c.idf");
static constexpr size_t I2C_MAX_LOG_BYTES = 32;
void IDFI2CBus::setup() {}
void IDFI2CBus::dump_config() {}
#include "wab_gen_idf.inc"
}  // namespace esphome::i2c
#undef USE_ESP32

esp_err_t i2c_master_execute_defined_operations(i2c_master_dev_handle_t, i2c_operation_job_t *ops, size_t n, int) {
  auto &jn = wab::jobs_note();
  jn.clear();
  for (size_t i = 0; i < n; i++) {
    char t[16];
    switch (ops[i].command) {
      case I2C_MASTER_CMD_START: jn += "S "; break;
      case I2C_MASTER_CMD_STOP: jn += "P "; break;
      case I2C_MASTER_CMD_WRITE: snprintf(t, sizeof t, "W%zu ", ops[i].write.total_bytes); jn += t; break;
      case I2C_MASTER_CMD_READ: snprintf(t, sizeof t, "R%zu%s ", ops[i].read.total_bytes,
                                         ops[i].read.ack_value == I2C_NACK_VAL ? "n" : "a"); jn += t; break;
    }
  }
  auto &w = wab::wire();
  auto &s = wab::slave();
  if (n > SOC_I2C_CMD_REG_NUM) {
    w.note("INVALID_ARG_TOO_MANY_JOBS");
    return ESP_ERR_INVALID_ARG;
  }
  for (size_t i = 0; i + 1 < n; i++) {
    if (ops[i].command == I2C_MASTER_CMD_READ && ops[i + 1].command == I2C_MASTER_CMD_STOP &&
        ops[i].read.ack_value != I2C_NACK_VAL) {
      w.note("INVALID_ARG_ACK_BEFORE_STOP");
      return ESP_ERR_INVALID_ARG;
    }
  }
  bool expect_addr = false;
  for (size_t i = 0; i < n; i++) {
    auto &op = ops[i];
    switch (op.command) {
      case I2C_MASTER_CMD_START:
        w.start();
        expect_addr = true;
        break;
      case I2C_MASTER_CMD_STOP:
        w.stop();
        break;
      case I2C_MASTER_CMD_WRITE:
        for (size_t k = 0; k < op.write.total_bytes; k++) {
          uint8_t b = op.write.data[k];
          bool ack = expect_addr ? s.address(b) : s.data(b);
          expect_addr = false;
          w.wbyte(b, ack);
          if (!ack && op.write.ack_check) {
            w.note("ABORT");
            w.stop();
            return ESP_ERR_INVALID_STATE;
          }
        }
        break;
      case I2C_MASTER_CMD_READ:
        for (size_t k = 0; k < op.read.total_bytes; k++) {
          op.read.data[k] = s.next_read();
          w.rbyte(op.read.data[k], op.read.ack_value == I2C_ACK_VAL);
        }
        break;
    }
  }
  return ESP_OK;
}

struct IdfInit { using type = bool esphome::i2c::IDFI2CBus::*; friend type get(IdfInit); };
template struct WabRob<IdfInit, &esphome::i2c::IDFI2CBus::initialized_>;
esphome::i2c::I2CBus *wab_make_idf() {
  auto *b = new esphome::i2c::IDFI2CBus();
  b->*get(IdfInit()) = true;
  return b;
}
