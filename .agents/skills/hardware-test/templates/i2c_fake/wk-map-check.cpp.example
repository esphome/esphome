#include <cstdint>
#include <cstdio>
enum RegType { REG = 0, FIFO = 1 };
namespace base {
inline uint8_t i2c_address(uint8_t base_address, uint8_t channel, RegType fifo) {
  // the address of the device is:
  // +----+----+----+----+----+----+----+----+
  // |  0 | A1 | A0 |  1 |  0 | C1 | C0 |  F |
  // +----+----+----+----+----+----+----+----+
  // where:
  // - A1,A0 is the address read from A1,A0 switch
  // - C1,C0 is the channel number (in practice only 00 or 01)
  // - F is: 0 when accessing register, one when accessing FIFO
  uint8_t const addr = base_address | channel << 1 | fifo << 0;
  return addr;
}
}
namespace pr {
inline uint8_t i2c_address(uint8_t base_address, uint8_t channel, RegType fifo) {
  // the address of the device is:
  // +----+----+----+----+----+----+----+----+
  // |  0 | A1 | A0 |  1 |  0 | C1 | C0 |  F |
  // +----+----+----+----+----+----+----+----+
  // where:
  // - A1,A0 is the address read from A1,A0 switch
  // - C1,C0 is the channel number (in practice only 00 or 01)
  // - F is: 0 when accessing register, one when accessing FIFO
  uint8_t const addr = base_address | channel << 1 | fifo << 0;
  return addr;
}
inline uint8_t i2c_register(uint8_t reg, uint8_t &channel) {
  if (reg > 0x0F) {
    channel = (reg >> 4) & 0x03;
  }
  return reg & 0x0F;
}
}
int main() {
  int same = 0, diff = 0;
  const uint8_t B = 0x10;
  for (int ch = 0; ch < 4; ch++)
    for (int reg = 0; reg < 0x40; reg++) {
      uint8_t ba = base::i2c_address(B, ch, REG), br = reg;  // base sends register_ unchanged
      uint8_t c = ch;
      uint8_t pr_reg = pr::i2c_register(reg, c);
      uint8_t pa = pr::i2c_address(B, c, REG);
      bool eq = ba == pa && br == pr_reg;
      if (reg < 0x10) { eq ? same++ : diff++; if (!eq) printf("MISMATCH ch%d reg %02X\n", ch, reg); }
      else if (reg == 0x10 || reg == 0x11 || reg == 0x21 || reg == 0x31)
        printf("global %02X ch%d: base @%02X r=%02X -> PR @%02X r=%02X\n", reg, ch, ba, br, pa, pr_reg);
    }
  printf("regs below 0x10, 4 channels: %d same, %d different\n", same, diff);
  for (int ch = 0; ch < 4; ch++) printf("FIFO ch%d: base @%02X PR @%02X\n", ch, base::i2c_address(B, ch, FIFO), pr::i2c_address(B, ch, FIFO));
}
