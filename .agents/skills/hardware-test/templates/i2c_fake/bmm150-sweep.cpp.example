#ifdef USE_HOST
// esphome#22778: the PR's bmm150_parse_trim/bmm150_convert against the merge base's copy (bmm150_aux_base.h),
// bit for bit, over exhaustive per-field sweeps with edge trims and random raw/trim pairs.
#include <gtest/gtest.h>

#include <array>
#include <cmath>
#include <cstdint>
#include <vector>
#include <cstring>
#include <random>
#include "esphome/components/bmi270/bmm150_aux.h"
#include "bmm150_aux_base.h"

namespace esphome::bmi270::testing {

static uint32_t bits(float f) {
  uint32_t u;
  std::memcpy(&u, &f, 4);
  return u;
}

struct Counts {
  uint64_t checked{0}, mismatched{0}, nan{0}, finite{0};
};

static void check(const uint8_t *trim_regs, const uint8_t *raw, Counts &c) {
  const auto tp = bmm150::bmm150_parse_trim(trim_regs);
  const auto tb = bmm150_base::bmm150_parse_trim(trim_regs);
  static_assert(sizeof(tp) == sizeof(tb));
  const auto p = bmm150::bmm150_convert(tp, raw);
  const auto b = bmm150_base::bmm150_convert(tb, raw);
  c.checked++;
  bool same = std::memcmp(&tp, &tb, sizeof(tp)) == 0 && bits(p.x) == bits(b.x) && bits(p.y) == bits(b.y) &&
              bits(p.z) == bits(b.z);
  if (!same) {
    if (c.mismatched < 5)
      ADD_FAILURE() << "mismatch raw " << std::hex << (int) raw[0] << " " << (int) raw[1] << " " << (int) raw[2]
                    << " " << (int) raw[3] << " " << (int) raw[4] << " " << (int) raw[5] << " " << (int) raw[6]
                    << " " << (int) raw[7];
    c.mismatched++;
  }
  (std::isnan(p.x) || std::isnan(p.y) || std::isnan(p.z) ? c.nan : c.finite)++;
}

TEST(BMM150Sweep22778, BaseAndPrDecodeIdentically) {
  std::vector<std::array<uint8_t, 24>> trims;
  // datasheet-like (same as the fake), all zero, all 0xFF, all 0x80, all 0x7F, alternating, and single zeroed words
  std::array<uint8_t, 24> ds{0xFE, 0x03, 0, 0, 0, 0xF6, 0xFF, 0x1A, 0x1B, 0, 0, 0xF8, 0x02, 0xD2, 0x60, 0xBD, 0x1B,
                             0x40, 0, 0xFD, 0x1D, 0, 0, 0};
  trims.push_back(ds);
  for (uint8_t fill : {0x00, 0xFF, 0x80, 0x7F, 0x01}) {
    std::array<uint8_t, 24> t;
    t.fill(fill);
    trims.push_back(t);
  }
  for (int off : {11, 13, 15}) {  // z2 = 0, z1 = 0, xyz1 = 0 give NaN paths
    auto t = ds;
    t[off] = t[off + 1] = 0;
    trims.push_back(t);
  }
  {
    auto t = ds;
    t[16] = 0xFF;  // xyz1 with bit 15 set (masked)
    trims.push_back(t);
  }
  const uint8_t backgrounds[3][8] = {{0x10, 0x12, 0x20, 0xF0, 0x30, 0x08, 0x40, 0x1A},
                                     {0x00, 0x80, 0x00, 0x80, 0x00, 0x80, 0xFC, 0xFF},
                                     {0xF8, 0x7F, 0x07, 0x00, 0x01, 0xC0, 0x00, 0x00}};
  Counts c;
  for (auto &t : trims)
    for (auto &bg : backgrounds)
      for (int field = 0; field < 4; field++)
        for (uint32_t w = 0; w <= 0xFFFF; w++) {
          uint8_t raw[8];
          std::memcpy(raw, bg, 8);
          raw[2 * field] = w & 0xFF;
          raw[2 * field + 1] = w >> 8;
          check(t.data(), raw, c);
        }
  const uint64_t exhaustive = c.checked;
  std::mt19937 rng(22778);
  for (int i = 0; i < 3000000; i++) {
    uint8_t t[24], raw[8];
    for (auto &b : t)
      b = rng();
    for (auto &b : raw)
      b = rng();
    check(t, raw, c);
  }
  printf("BMM150_SWEEP exhaustive=%llu random=%llu mismatched=%llu nan_results=%llu finite_results=%llu\n",
         (unsigned long long) exhaustive, (unsigned long long) (c.checked - exhaustive),
         (unsigned long long) c.mismatched, (unsigned long long) c.nan, (unsigned long long) c.finite);
  EXPECT_EQ(c.mismatched, 0u);
}

}  // namespace esphome::bmi270::testing
#endif
