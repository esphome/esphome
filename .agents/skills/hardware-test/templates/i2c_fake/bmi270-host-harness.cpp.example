#ifdef USE_HOST
// Host harness for esphome#22778. Runs BMI270Component::setup() and update_data() against bmi270fake::Bus for every
// scenario and writes one report to $BMI_OUT: per scenario the outcome (failed, error reason, warning, magnetometer
// ready), the log lines, the final registers, decoded values and the raw transaction stream.
// $BMI_EXPECTED_FNV (hex, optional) overrides the fake's expected config table hash.
// Scenarios: configs from $BMI_SETTERS (lines "name setter value", parsed from each tree's generated main.cpp),
// aux faults, and a NACK at every main-bus transaction of the aux config.
#include <gtest/gtest.h>

#include <cmath>
#include <cstdio>
#include <cstdlib>
#include <fstream>
#include <map>
#include <memory>
#include <sstream>
#include <string>
#include <vector>
#ifndef USE_BMI270_BMM150
#error "build with -DUSE_BMI270_BMM150 (benchmark.yaml build_flags)"
#endif
#ifndef USE_LOG_LISTENERS
#error "build with -DUSE_LOG_LISTENERS"
#endif
#define protected public  // read magnetometer_ready_ and call update_data(); harness only
#include "esphome/components/bmi270/bmi270.h"
#undef protected
#include "esphome/components/bmi270/bmi270_config.h"
#include "esphome/components/logger/logger.h"
#include "bmi270fake.hpp"

namespace esphome::bmi270::testing {

static std::vector<std::string> g_lines;

struct Setter {
  std::string fn;
  int value;
};
using SetterMap = std::map<std::string, std::vector<Setter>>;

static SetterMap load_setters() {
  SetterMap m;
  std::ifstream f(std::getenv("BMI_SETTERS"));
  std::string name, fn;
  int v;
  while (f >> name >> fn >> v)
    m[name].push_back({fn, v});
  return m;
}

static void apply(BMI270Component &imu, const std::vector<Setter> &setters) {
  for (auto &s : setters) {
    if (s.fn == "set_accel_range")
      imu.set_accel_range((BMI270AccelRange) s.value);
    else if (s.fn == "set_accel_odr")
      imu.set_accel_odr((BMI270AccelODR) s.value);
    else if (s.fn == "set_gyro_range")
      imu.set_gyro_range((BMI270GyroRange) s.value);
    else if (s.fn == "set_gyro_odr")
      imu.set_gyro_odr((BMI270GyroODR) s.value);
    else if (s.fn == "set_aux_device")
      imu.set_aux_device((BMI270AuxDevice) s.value);
    else if (s.fn == "set_aux_device_address")
      imu.set_aux_device_address(s.value);
    else if (s.fn != "none")
      ADD_FAILURE() << "unknown setter " << s.fn;
  }
}

struct Result {
  std::string text;
  uint32_t tx;
  std::vector<std::string> txlog;
};

// aux_addr: the address the fake BMM150 answers on
static Result run(const std::string &label, const std::vector<Setter> &setters, uint8_t aux_addr, uint8_t bmm_mode,
                  bool busy_stuck, uint32_t nack_at, bool full, uint8_t stuck_from = 0) {
  auto bus = std::make_unique<bmi270fake::Bus>();
  if (const char *fnv = std::getenv("BMI_EXPECTED_FNV"))
    bus->expected_fnv = std::strtoul(fnv, nullptr, 16);
  bus->init_bmm(aux_addr, bmm_mode);
  bus->busy_stuck = busy_stuck;
  bus->nack_at = nack_at;
  bus->stuck_from_aux_op = stuck_from;
  BMI270Component imu;
  imu.set_i2c_bus(bus.get());
  imu.set_i2c_address(0x68);
  apply(imu, setters);
  float temp = NAN;
  bmm150::BMM150Data mag{NAN, NAN, NAN};
  imu.add_temperature_listener([&temp](float t) { temp = t; });
  imu.add_magnetometer_listener([&mag](const bmm150::BMM150Data &m) { mag = m; });
  g_lines.clear();
  imu.setup();
  const uint32_t setup_tx = bus->transactions;
  motion::MotionData d{};
  bool sampled = imu.update_data(d);
  std::ostringstream o;
  char fr[240];
  bus->final_regs(fr, sizeof(fr));
  o << "SCENARIO " << label << "\n";
  o << "  failed=" << imu.is_failed() << " warning=" << imu.status_has_warning()
    << " error=" << imu.status_has_error() << " mag_ready=" << imu.magnetometer_ready_ << " setup_tx=" << setup_tx
    << " status=0x" << std::hex << (int) bus->regs[0x21] << std::dec << "\n";
  for (auto &l : g_lines)
    o << "  LOG " << l << "\n";
  if (full || !imu.is_failed()) {
    o << "  REGS " << fr << "\n";
    char vals[300];
    snprintf(vals, sizeof(vals),
             "  VALUES sampled=%d ax=%.6f ay=%.6f az=%.6f gx=%.5f gy=%.5f gz=%.5f t=%.4f mx=%.6f my=%.6f mz=%.6f\n",
             sampled, d.acceleration[0], d.acceleration[1], d.acceleration[2], d.angular_rate[0], d.angular_rate[1],
             d.angular_rate[2], temp, mag.x, mag.y, mag.z);
    o << vals;
    o << "  UPLOAD mem_fnv=" << std::hex << bus->mem_fnv << std::dec << " rewrites=" << bus->rewrites
      << " perr=" << bus->protocol_errors << " data_writes=" << bus->data_writes << " burst=" << bus->burst_min << ".."
      << bus->burst_max << " aux_w=" << bus->aux_writes << " aux_r=" << bus->aux_reads
      << " status_reads=" << bus->status_reads << " norm=" << std::hex << bus->norm_fnv << std::dec << "\n";
  }
  if (full) {
    for (auto &l : bus->log)
      o << "  TX " << l << "\n";
    std::string memp = std::string(std::getenv("BMI_OUT")) + "." + label + ".mem";
    FILE *f = std::fopen(memp.c_str(), "wb");
    std::fwrite(bus->mem, 1, sizeof(bus->mem), f);
    std::fclose(f);
  }
  return {o.str(), setup_tx, bus->log};
}

TEST(BMI270Harness22778, AllScenarios) {
  ASSERT_NE(std::getenv("BMI_OUT"), nullptr);
  logger::global_logger->add_log_callback(nullptr, [](void *, uint8_t level, const char *tag, const char *msg,
                                                      size_t len) {
    std::string s(msg, len);
    // drop the colour/header prefix up to the tag's closing bracket
    auto p = s.find("]: ");
    g_lines.push_back(std::string(1, "NEWICDVV"[level & 7]) + " " + tag + ": " +
                      (p == std::string::npos ? s : s.substr(p + 3)));
  });
  SetterMap setters = load_setters();
  ASSERT_FALSE(setters.empty());
  std::ofstream out(std::string(std::getenv("BMI_OUT")) + ".report");
  uint32_t aux_tx = 0;
  std::vector<std::string> aux_log;
  for (auto &[name, list] : setters) {
    uint8_t aux_addr = 0x10;
    for (auto &s : list)
      if (s.fn == "set_aux_device_address")
        aux_addr = s.value;
    auto r = run("cfg_" + name, list, aux_addr, 0, false, 0, true);
    out << r.text;
    if (name == "aux") {
      aux_tx = r.tx;
      aux_log = r.txlog;
    }
  }
  ASSERT_NE(aux_tx, 0u);
  const auto &aux = setters["aux"];
  out << run("aux_absent", aux, 0x10, 1, false, 0, false).text;
  out << run("aux_wrong_id", aux, 0x10, 2, false, 0, false).text;
  out << run("aux_busy_stuck", aux, 0x10, 0, true, 0, false).text;
  out << run("aux_wrong_address", aux, 0x11, 0, false, 0, false).text;
  // One failure per BMM150 setup step: a NACK on the main-bus write of that step, or the aux busy bit stuck from
  // the step's aux transfer on (1 power-on, 2 soft reset, 3 chip ID read, 4-6 trim reads, 7 normal mode)
  auto main_index = [&](const std::string &prefix) -> uint32_t {
    uint32_t n = 0;
    for (auto &l : aux_log) {
      if (l.rfind("A ", 0) == 0)
        continue;
      n++;
      if (l.rfind(prefix, 0) == 0 && n > 60)  // after the config upload
        return n;
    }
    ADD_FAILURE() << "no transaction " << prefix;
    return 0;
  };
  const std::pair<const char *, const char *> nack_steps[] = {
      {"step_aux_if_conf_nack", "W 6b 20"},     {"step_aux_manual_nack", "W 4c 8c"},
      {"step_aux_dev_id_nack", "W 4b 20"},      {"step_power_on_data_nack", "W 4f 01"},
      {"step_soft_reset_data_nack", "W 4f 83"}, {"step_chip_id_rd_addr_nack", "W 4d 40"},
      {"step_trim_rd_addr_nack", "W 4d 5d"},    {"step_normal_mode_data_nack", "W 4f 38"},
      {"step_auto_burst_conf_nack", "W 4c 4f"}, {"step_auto_burst_rd_addr_nack", "W 4d 42"},
      {"step_auto_burst_pwr_ctrl_nack", "W 7d 0f"},
  };
  for (auto &[label, prefix] : nack_steps)
    out << run(label, aux, 0x10, 0, false, main_index(prefix), false).text;
  // the soft reset writes the same AUX_WR_ADDR as power-on; the second "W 4e 4b" is the soft reset one
  const char *stuck_labels[] = {"step_power_on_busy", "step_soft_reset_busy", "step_chip_id_read_busy",
                                "step_trim1_busy",    "step_trim2_busy",      "step_trim3_busy",
                                "step_normal_mode_busy"};
  for (uint8_t op = 1; op <= 7; op++)
    out << run(stuck_labels[op - 1], aux, 0x10, 0, false, 0, false, op).text;
  out << run("step_chip_id_wrong", aux, 0x10, 2, false, 0, false).text;
  for (uint32_t n = 1; n <= aux_tx; n++)
    out << run("nack_" + std::to_string(n), aux, 0x10, 0, false, n, false).text;
  out << "NACK_TOTAL " << aux_tx << "\n";
}

}  // namespace esphome::bmi270::testing
#endif
